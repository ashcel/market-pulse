# Copy to backend/.env — never commit the real one.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5435/market_pulse
REDIS_URL=redis://localhost:6380/0
ENVIRONMENT=production
SITE_DOMAIN=iq.heydewi.com

# Shared secret for server-to-server calls from the TanStack Start frontend
# (checked against the X-Internal-Key header; paired with X-Internal-User-Id).
INTERNAL_API_KEY=change-me-in-production
# Base URL the frontend uses to reach this backend for server-to-server calls.
BACKEND_URL=http://localhost:8002

# Bybit Trade Review is retired (superseded by Binance below) — app/bybit/ is
# unregistered dead code, kept only because nothing forced its removal. This
# var is harmless to leave set but no longer read by any live router.
BYBIT_ENCRYPTION_SECRET=change-me-in-production

# Symmetric key (arbitrary-length passphrase, SHA-256-derived into a Fernet
# key) used to encrypt the Trade Review Binance API secret at rest in
# binance_review_keys. Rotating this makes previously-stored secrets
# undecryptable — re-save the API key after rotating. Separate from
# EXECUTION_ENCRYPTION_SECRET (the live-execution key class) by design — see
# backend/app/binance_review/service.py.
BINANCE_REVIEW_ENCRYPTION_SECRET=change-me-in-production
# Trade Review needs the user's real mainnet history by default; flip to
# true only for local/staging testing against Binance's futures testnet.
BINANCE_REVIEW_TESTNET=false
