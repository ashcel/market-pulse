[Unit]
Description=Market Pulse API (FastAPI)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/code/personal/market-pulse/backend
EnvironmentFile=/home/ubuntu/code/personal/market-pulse/backend/.env
ExecStart=/home/ubuntu/code/personal/market-pulse/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target