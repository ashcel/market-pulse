# Template for /etc/market-pulse-worker.env (EnvironmentFile of
# market-pulse-worker.service). Copy it there and fill in real values —
# this file itself stays a placeholder-only template in git.
#
#   sudo cp deploy/worker.env.example /etc/market-pulse-worker.env
#   sudo chmod 600 /etc/market-pulse-worker.env

# Prod Postgres (docker-compose.yml on this VPS, or a managed instance).
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5435/market_pulse

# Eval+settle cadence (ms). Default 5m — matches the web app's default so a
# shared DATABASE_URL sees a consistent cadence.
WORKER_INTERVAL_MS=300000

# Deployed commit, for provenance (falls back to "unknown" if unset).
GIT_SHA=
