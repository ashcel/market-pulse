# Autonomous forward-test worker (WS4). Runs alongside `market-pulse.service`
# (the web SSR process) as its own unit so evaluation/settlement stays off the
# request path and keeps advancing across web restarts/deploys.
#
# Install (manual — not run by Claude):
#   sudo cp deploy/market-pulse-worker.service /etc/systemd/system/
#   sudo cp deploy/worker.env.example /etc/market-pulse-worker.env   # then fill in real values
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now market-pulse-worker
#
# Logs: journalctl -u market-pulse-worker -f

[Unit]
Description=Market Pulse forward-test worker (autonomous eval+settle loop)
After=network.target market-pulse.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/code/personal/market-pulse
EnvironmentFile=/etc/market-pulse-worker.env
ExecStart=/home/ubuntu/.bun/bin/bun run src/server/worker/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
