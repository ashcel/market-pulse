# Copy to frontend/.env (gitignored) for local dev and the vitest
# DB-integration suite. Bun auto-loads frontend/.env from this directory, so
# `bunx vitest run` picks it up — without it, the DB-integration tests under
# src/server/db/ hit the client fallback and fail Postgres auth.
#
# Point it at the local docker Postgres (docker-compose.yml, port 5435).
# On the production VPS the systemd unit supplies DATABASE_URL instead
# (/etc/market-pulse.env), so this file is dev/test-only.
DATABASE_URL=postgres://postgres:postgres@localhost:5435/market_pulse
