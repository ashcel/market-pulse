# Postgres — the forward-test system of record (docker-compose.yml).
# POSTGRES_PASSWORD seeds the container on FIRST init of the data volume only;
# DATABASE_URL is what the app/worker actually connect with. Keep them in sync.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5435/market_pulse

# Public base URL, used to build invite / login links.
APP_URL=http://localhost:3000

# Worker eval+settle cadence (ms). Default 5m.
WORKER_INTERVAL_MS=300000

# Injected at build/deploy for record provenance (falls back to "unknown").
# GIT_SHA=

MARKET_PULSE_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Free-tier AI proxy (/api/ai/chat/completions) ---------------------------
# Server-held keys for the fallback chain in
# frontend/src/server/ai/proxy-chain.json. Each entry is skipped until its key
# is set, and the endpoint answers 503 when none are — the client then falls
# back to the user's own BYOK provider. On the VPS these live in
# /etc/market-pulse.env (EnvironmentFile of market-pulse.service), never here.
AI_PROXY_TOKENROUTER_KEY=
AI_PROXY_OPENCODE_KEY=
AI_PROXY_GROQ_KEY=
AI_PROXY_OPENROUTER_KEY=
AI_PROXY_GEMINI_KEY=
AI_PROXY_CEREBRAS_KEY=

# Quota guard for that endpoint. Defaults: 5 requests per caller per hour,
# 500 across all callers per UTC day.
AI_PROXY_PER_CALLER=
AI_PROXY_WINDOW_MS=
AI_PROXY_DAILY_TOTAL=
